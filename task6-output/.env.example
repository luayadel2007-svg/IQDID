# Secrets are NOT set here. Generate ./secrets/db_bootstrap_password.txt locally:
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b) | Set-Content -NoNewline secrets\db_bootstrap_password.txt
#   Linux:      openssl rand -base64 32 | tr -d '\n' > secrets/db_bootstrap_password.txt
